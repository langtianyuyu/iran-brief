# Required
QUESTRADE_REFRESH_TOKEN=replace_me
QUESTRADE_ACCOUNT_ID=replace_me
QUESTRADE_IS_DEMO=false

# Safety switch: must be true to place real orders
TRADE_ENABLED=false

# Risk controls
MAX_TRADES_PER_DAY=3
MAX_NOTIONAL_PER_TRADE=20
DAILY_LOSS_LIMIT=5

# Tech + bitcoin-related universe (comma-separated)
TRADE_UNIVERSE=AAPL,MSFT,NVDA,AMD,META,PLTR,SOFI,SPY,QQQ,BITO,MSTR,COIN
